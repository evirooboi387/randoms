CREATE DATABASE IF NOT EXISTS BOOTCAMP;

SHOW DATABASES LIKE 'BOOTCAMP';

CREATE SCHEMA IF NOT EXISTS BOOTCAMP.SNOW;

USE DATABASE BOOTCAMP;

USE SCHEMA SNOW;

SHOW SCHEMAS IN DATABASE BOOTCAMP;

SELECT
    CURRENT_DATABASE(),
    CURRENT_SCHEMA();

CREATE TABLE BOOTCAMP.SNOW.EMPLOYEE (
    EMPLOYEE_ID   NUMBER(10,0),
    NAME          VARCHAR(100),
    SALARY        NUMBER(10,2),
    DEPARTMENT_ID NUMBER(10,0),
    JOINING_DATE  DATE
);


DESCRIBE TABLE BOOTCAMP.SNOW.EMPLOYEE;

CREATE OR REPLACE FILE FORMAT BOOTCAMP.SNOW.EMPLOYEE_CSV_FORMAT
    TYPE = CSV
    SKIP_HEADER = 1
    FIELD_OPTIONALLY_ENCLOSED_BY = '"'
    EMPTY_FIELD_AS_NULL = TRUE;

SELECT CURRENT_ROLE();

DESC FILE FORMAT BOOTCAMP.SNOW.EMPLOYEE_CSV_FORMAT;

CREATE STAGE IF NOT EXISTS BOOTCAMP.SNOW.EMPLOYEE_STAGE
    FILE_FORMAT = BOOTCAMP.SNOW.EMPLOYEE_CSV_FORMAT

SHOW STAGES IN SCHEMA BOOTCAMP.SNOW;

LIST @BOOTCAMP.SNOW.EMPLOYEE_STAGE;

COPY INTO BOOTCAMP.SNOW.EMPLOYEE
FROM @BOOTCAMP.SNOW.EMPLOYEE_STAGE
FILES = ('Employee.csv')
FILE_FORMAT = (
    FORMAT_NAME = 'BOOTCAMP.SNOW.EMPLOYEE_CSV_FORMAT'
)
ON_ERROR = 'ABORT_STATEMENT';



