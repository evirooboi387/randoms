–create the listing table in snowflake

USE ROLE ACCOUNTADMIN;
USE DATABASE bootcamp;
USE SCHEMA snow;

CREATE TABLE IF NOT EXISTS listing (
    listid INTEGER,
    sellerid INTEGER,
    eventid INTEGER,
    dateid SMALLINT,
    numtickets SMALLINT,
    priceperticket NUMBER(18,2),
    totalprice NUMBER(18,2),
    listtime TIMESTAMP_NTZ
);

–create the external stage
CREATE OR REPLACE STAGE bootcamp.snow.listing_stage
URL = 's3://riwaj-bootcamp-1234/snowflake/listing/'
STORAGE_INTEGRATION = snowflake_s3_integration
FILE_FORMAT = (TYPE = PARQUET);





–Load Parquet data into individual Snowflake columns
COPY INTO bootcamp.snow.listing
FROM @bootcamp.snow.listing_stage
FILE_FORMAT = (
    TYPE = PARQUET
    USE_LOGICAL_TYPE = TRUE
)
MATCH_BY_COLUMN_NAME = CASE_INSENSITIVE
ON_ERROR = ABORT_STATEMENT;


