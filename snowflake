CREATE DATABASE IF NOT EXISTS BOOTCAMP;

SHOW DATABASES LIKE 'BOOTCAMP';

CREATE SCHEMA IF NOT EXISTS BOOTCAMP.SNOW;

USE DATABASE BOOTCAMP;

USE SCHEMA SNOW;

SHOW SCHEMAS IN DATABASE BOOTCAMP;

SELECT
    CURRENT_DATABASE(),
    CURRENT_SCHEMA();

CREATE TABLE BOOTCAMP.SNOW.EMPLOYEE (
    EMPLOYEE_ID   NUMBER(10,0),
    NAME          VARCHAR(100),
    SALARY        NUMBER(10,2),
    DEPARTMENT_ID NUMBER(10,0),
    JOINING_DATE  DATE
);


DESCRIBE TABLE BOOTCAMP.SNOW.EMPLOYEE;